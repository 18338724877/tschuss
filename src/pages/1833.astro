---
import BlogLayout from '../layouts/BlogLayout.astro'
---
<BlogLayout
  title="1-833-TSCHUSS"
  headerImage="/assets/hotline-header.png"
  headerAlt="1-833-TSCHUSS"
  headerMaxWidth="900px"
  plainBackground={true}
>
  <div class="hotline-page">
    <p class="hotline-intro">
      Welcome to the Tschüß hotline, a way to publicize your stories, opinions and darkest secrets anonymously.
      Call and leave a voicemail to be featured on Instagram or TikTok. Send a text to be featured on X, Threads,
      and BlueSky. Click below to view your social media company of choice.
    </p>

    <img
      class="hotline-cord"
      id="hotline-cord"
      src="/assets/hotline-cord.png"
      alt=""
    />

    <div class="hotline-socials">
      <a href="https://www.instagram.com/ts.chuss/reels/" target="_blank" rel="noopener">
        <img src="/assets/social-instagram.png" alt="Instagram" />
      </a>
      <a href="https://www.tiktok.com/@ts.chuss" target="_blank" rel="noopener">
        <img src="/assets/social-tiktok.png" alt="TikTok" />
      </a>
      <a href="https://twitter.com/tschuss_me" target="_blank" rel="noopener">
        <img src="/assets/social-x.png" alt="X" />
      </a>
      <a href="https://threads.net/@ts.chuss" target="_blank" rel="noopener">
        <img src="/assets/social-threads.png" alt="Threads" />
      </a>
      <a href="https://bsky.app/profile/tschuss.bsky.social" target="_blank" rel="noopener">
        <img src="/assets/social-bluesky.png" alt="BlueSky" />
      </a>
    </div>

    <div class="hotline-actions">
      <a class="hotline-action" href="tel:18338724877">
        <img src="/assets/hotline-call-button.png" alt="Click to call now" />
      </a>
      <a class="hotline-action" href="sms:18338724877">
        <img src="/assets/hotline-text-button.png" alt="Click to text now" />
      </a>
    </div>

    <img
      class="hotline-desktop-note"
      src="/assets/hotline-desktop.png"
      alt="On a desktop?"
    />

    <div class="hotline-form-wrap">
      <h2 class="hotline-form-title">Submit Anonymously</h2>
      <p class="hotline-form-note" id="hotline-form-note">
        Fill this out and it'll be sent directly to us, no name or email required.
      </p>
      <form class="hotline-form" id="hotline-form">
        <input type="hidden" name="access_key" value="bd23927c-950d-41bb-9533-b512d7506363" />
        <input type="hidden" name="subject" value="New anonymous submission — Tschüß hotline" />
        <input type="checkbox" name="botcheck" style="display:none" />
        <input type="text" name="name" placeholder="Name (optional)" />
        <textarea name="message" placeholder="Your story, opinion, or secret..." rows="6" required></textarea>
        <button type="submit">Submit Anonymously</button>
      </form>
    </div>
  </div>
</BlogLayout>

<script>
  const form = document.getElementById('hotline-form') as HTMLFormElement
  const note = document.getElementById('hotline-form-note')!

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const submitBtn = form.querySelector('button')!
    submitBtn.textContent = 'Sending...'
    submitBtn.setAttribute('disabled', 'true')

    const formData = new FormData(form)
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      })
      const result = await res.json()
      if (result.success) {
        form.reset()
        note.textContent = 'Thank you! Your secret is safe with us.'
      } else {
        note.textContent = 'Something went wrong. Please try again.'
      }
    } catch {
      note.textContent = 'Something went wrong. Please try again.'
    }
    submitBtn.textContent = 'Submit Anonymously'
    submitBtn.removeAttribute('disabled')
  })

  const cord = document.getElementById('hotline-cord')!
  cord.addEventListener('mouseenter', () => cord.classList.add('stretch'))
  cord.addEventListener('mouseleave', () => cord.classList.remove('stretch'))
  cord.addEventListener('mousedown', () => cord.classList.add('stretch-more'))
  cord.addEventListener('mouseup', () => cord.classList.remove('stretch-more'))
  cord.addEventListener('touchstart', () => cord.classList.add('stretch'))
  cord.addEventListener('touchend', () => cord.classList.remove('stretch'))
</script>

<style>
  .hotline-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 1rem 1.25rem 5rem;
    text-align: center;
  }
  .hotline-intro {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }
  .hotline-cord {
    display: block;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-bottom: 3rem;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
  }
  .hotline-cord.stretch {
    transform: scaleX(1.06) scaleY(0.92);
  }
  .hotline-cord.stretch-more {
    transform: scaleX(1.14) scaleY(0.82);
  }
  .hotline-socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2.25rem;
    margin-bottom: 3.5rem;
  }
  .hotline-socials img {
    width: 110px;
    height: 110px;
    display: block;
    transition: transform 0.2s ease;
  }
  .hotline-socials a:hover img {
    transform: scale(1.15);
  }
  .hotline-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .hotline-action img {
    max-width: 300px;
    width: 100%;
    height: auto;
    transition: transform 0.2s ease;
  }
  .hotline-action:hover img {
    transform: scale(1.05);
  }
  .hotline-desktop-note {
    max-width: 360px;
    width: 100%;
    margin: 0 auto 3.5rem;
  }
  .hotline-form-wrap {
    border-top: 1px solid rgba(0, 0, 0, 0.15);
    padding-top: 2.5rem;
  }
  .hotline-form-title {
    font-family: var(--font-body);
    color: var(--color-accent);
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
  }
  .hotline-form-note {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: rgba(0, 0, 0, 0.55);
    margin: 0 0 1.25rem;
  }
  .hotline-form input[type='text'] {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.85rem;
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }
  .hotline-form textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.85rem;
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    resize: vertical;
    margin-bottom: 1rem;
  }
  .hotline-form button {
    background: #111;
    color: #fff;
    border: none;
    padding: 0.85rem 1.75rem;
    border-radius: 4px;
    font-family: var(--font-body);
    font-weight: 700;
    cursor: pointer;
  }
  .hotline-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>
<style>
  @media (max-width: 600px) {
    .hotline-socials {
      gap: 0.9rem;
    }
    .hotline-socials img {
      width: 44px;
      height: 44px;
    }
    .hotline-actions {
      gap: 1rem;
    }
    .hotline-action img {
      max-width: 140px;
    }
    .hotline-desktop-note {
      max-width: 200px;
    }
  }
</style>
