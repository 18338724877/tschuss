---
import BlogLayout from '../layouts/BlogLayout.astro'
---
<BlogLayout title="Home" hideHeader={true} plainBackground={true}>
  <div class="coming-soon">
    <p>Coming Soon</p>
  </div>
</BlogLayout>

<style>
  .coming-soon {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .coming-soon p {
    font-family: 'Helvetica Neue', 'Arial Narrow', Arial, sans-serif;
    font-stretch: condensed;
    font-size: 36pt;
    color: #111;
    margin: 0;
  }
</style>
